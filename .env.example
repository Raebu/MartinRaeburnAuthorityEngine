NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://authority:authority@localhost:5432/authority
API_KEY=change-me
PUBLIC_BASE_URL=http://localhost:8080

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini

# Email / outreach
RESEND_API_KEY=
OUTREACH_FROM=Martin Raeburn <contact@martinraeburn.com>
OUTREACH_REPLY_TO=contact@martinraeburn.com

# Discovery feeds (comma-separated RSS/Atom URLs)
DISCOVERY_FEEDS=

# Site monitoring
SITE_BASE_URL=https://www.martinraeburn.com
SITE_MONITOR_PATHS=/,/about/,/the-group/,/work/,/speaking/,/connect/,/thinking/,/robots.txt,/sitemap.xml

# Worker intervals
DISCOVERY_INTERVAL_MINUTES=180
SITE_MONITOR_INTERVAL_MINUTES=30
